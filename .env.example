# Linear personal API key (raw key, sent without a "Bearer" prefix).
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub PAT with read access to the repositories below.
# Only ever handed to the Docker sandbox, never to the review model.
REVIEW_GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Required. The GitHub organization (or user) that owns the repositories.
GITHUB_ORG=my-org

# Required. Comma-separated allowlist of repository names. Nothing outside
# this list can be fetched or reviewed.
ALLOWED_REPOS=my-service,my-frontend

PORT=5178
# DATA_DIR=/absolute/path (default: <repo>/data)
CLAUDE_BIN=claude
REVIEW_MODEL=opus
REVIEW_TIMEOUT_MS=1800000
DOCKER_BIN=docker
GIT_IMAGE=code-review-tool-git:latest
