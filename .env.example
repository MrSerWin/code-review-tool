# Only the three values below must be set. Everything else has a default that
# lives in src/config.ts — the single source of truth. Uncomment an optional
# line only when you actually want to override that default.

# GitHub token with read access to the repositories below.
# Only ever handed to the Docker sandbox, never to the review model.
REVIEW_GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# The GitHub organization (or user) that owns the repositories.
GITHUB_ORG=my-org

# Allowlist of repository names, comma-separated. Nothing outside this list
# can be fetched or reviewed.
ALLOWED_REPOS=my-service,my-frontend

# --- ticket trackers; all optional, all off unless configured ---
# Configure none of them and reviews still work: paste the requirements in the
# UI, or pass --requirements on the command line. A tracker only fails when it
# is actually used. GitHub Issues need no extra variables: they reuse
# REVIEW_GH_TOKEN and GITHUB_ORG, so they are always available.

# Linear personal API key (raw key, sent without a "Bearer" prefix).
# LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxx

# Jira Cloud: site URL, account email, and API token.
# JIRA_BASE_URL=https://example.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Azure DevOps: organization URL, project, and a personal access token.
# AZURE_ORG_URL=https://dev.azure.com/example
# AZURE_PROJECT=my-project
# AZURE_PAT=xxxxxxxxxxxxxxxxxxxxxxxx

# YouTrack: base URL and a permanent token.
# YOUTRACK_BASE_URL=https://example.youtrack.cloud
# YOUTRACK_TOKEN=perm:xxxxxxxxxxxxxxxxxxxxxxxx

# Which tracker wins when a bare key like ABC-123 matches several configured
# ones: linear, jira, github, azure, or youtrack. Without it an ambiguous key is
# an error instead of a guess.
# DEFAULT_TRACKER=jira

# --- optional overrides; the value shown is the default ---
# API and UI port, always bound to 127.0.0.1. The web dev server (npm run dev)
# proxies /api to PORT from the shell environment, not from this file, so
# export PORT as well when you change it there.
# PORT=5178
# Where the database, checkouts, reports, and preview scratch directories live.
# DATA_DIR=<repo>/data
# Server and CLI log threshold: debug, info, warn, or error.
# LOG_LEVEL=info
# Which CLI reviews by default: claude, cursor, codex, or grok.
# DEFAULT_REVIEWER=claude
# Model lists are discovered at runtime from each reviewer's CLI (or the vendor
# API); nothing is built in. Each *_REVIEW_MODEL below only picks the default
# among the discovered models: unset, the first one is the default, and an id
# the list lacks is ignored with a warning (Claude Code takes any full model
# name). Run `npm run review -- --list-models` to see the lists.
#
# Claude Code CLI. Models: the Anthropic Models API when ANTHROPIC_API_KEY is
# set, else the model catalog Claude Code caches in
# ~/.claude/cache/model-catalog/, else the alias examples in `claude --help`.
# CLAUDE_BIN=claude
# REVIEW_MODEL=<an alias or full model name>
# Optional: only used to list models from the Anthropic Models API. Never
# passed to a review, which keeps using the CLI's own login.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Cursor Agent CLI. Models: `cursor-agent --list-models` (needs `cursor-agent
# login` or CURSOR_API_KEY).
# CURSOR_BIN=cursor-agent
# CURSOR_REVIEW_MODEL=<a model id from --list-models>
# Optional: a Cursor API key handed to the Cursor Agent CLI only, instead of
# relying on `cursor-agent login`.
# CURSOR_API_KEY=cursor_xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI Codex CLI. Models: $CODEX_HOME/models_cache.json, which the CLI writes
# on `codex login` or its first run.
# CODEX_BIN=codex
# CODEX_REVIEW_MODEL=<a model id from the Codex model cache>
# Where the tool looks for Codex's models_cache.json (the Codex CLI's own
# variable; it is not forwarded to the review process). Default: ~/.codex
# CODEX_HOME=/home/me/.codex
# Grok CLI. Models: `grok models` (needs `grok login`).
# GROK_BIN=grok
# GROK_REVIEW_MODEL=<a model id from `grok models`>
# Budget per review process: each lens and the synthesis pass gets this much.
# REVIEW_TIMEOUT_MS=1800000
# Reviews (branches) running at once. Each one fans out to 5 lens processes
# plus a synthesis pass, so the process ceiling is this value * 6.
# REVIEW_CONCURRENCY=2
# Docker CLI, and the tag of the git sandbox image (npm run docker:build).
# DOCKER_BIN=docker
# GIT_IMAGE=code-review-tool-git:latest

# --- local (unpushed) reviews; off unless a local clone is configured ---
# A directory whose children are your clones, named exactly like the entries of
# ALLOWED_REPOS. Only <LOCAL_REPOS_DIR>/<allowed name> is ever read, and only
# with read-only git commands. Enables `local:<repo>#<branch>` inputs.
# LOCAL_REPOS_DIR=/home/me/code
# Optional per-repo overrides, absolute paths: name=/abs/path,other=/abs/path
# LOCAL_REPOS=my-service=/home/me/work/my-service

# --- repository rules and tool checks; see rules.example/README.md ---
# Directory holding <repo>.md, _all.md and <repo>.json. Read per review, gitignored by default.
# RULES_DIR=<repo>/rules

# --- preview environments; off unless PREVIEW_ENABLED is set ---
# A preview runs the reviewed branches as a real, clickable stack. What to run
# lives in a recipe outside this repo; see recipes.example/README.md.
# 1, true, yes, or on (any case) turns previews on; anything else leaves them off.
# PREVIEW_ENABLED=0
# Directory holding <name>/recipe.json. Gitignored by default.
# PREVIEW_RECIPES_DIR=<repo>/recipes
# Host ports the engine may allocate, inclusive, within 1024-65535.
# PREVIEW_PORT_RANGE=21000-21999
# How long a preview stays up after it became ready before the reaper stops it.
# PREVIEW_TTL_MINUTES=120
# Previews being started (checkouts through health) at once; the rest queue. A
# ready preview no longer counts against it.
# PREVIEW_MAX_CONCURRENT=3

# --- not read from this file ---
# CODE_REVIEW_API_URL (default http://127.0.0.1:5178) is read by the MCP server
# (dist/mcp.js) from its own environment; that process never loads .env. Set it
# in your agent's MCP server entry when the API does not listen on the default.
# CODE_REVIEW_TOOL_REVIEWER is set by the tool on every reviewer process it
# starts; never set it yourself.
